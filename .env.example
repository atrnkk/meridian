# Copy to .env and fill in. Generate passwords with: openssl rand -hex 24

# Address of this machine. With https://, Caddy gets a certificate for the hostname,
# whose DNS must point here. Use http://localhost to run everything on your own PC.
MERIDIAN_URL=https://meridian.example.com

# Password for the insert-only user. Also goes into Roblox as the meridian_key secret.
CLICKHOUSE_INGEST_PASSWORD=

# Password for Grafana's read-only ClickHouse user. Never leaves this machine.
CLICKHOUSE_GRAFANA_PASSWORD=

# Password for the Grafana `admin` login.
GRAFANA_ADMIN_PASSWORD=
