          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT quantileExact(0.5)(JSONExtractFloat(props, 'duration')) AS median\nFROM meridian.events\nWHERE game_id = $game AND event = 'leave' AND $__timeFilter(ts)"
