    {
      "id": 11,
      "type": "table",
      "title": "Purchases by item",
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT\n    concat(JSONExtractString(props, 'kind'), ' ', JSONExtractRaw(props, 'id')) AS item,\n    count() AS purchases,\n    uniqExact(user_id) AS buyers\nFROM meridian.events\nWHERE game_id = $game AND event = 'purchase' AND $__timeFilter(ts)\nGROUP BY item\nORDER BY purchases DESC\nLIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Top events",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 14
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT event, count() AS count, uniqExactIf(user_id, user_id != 0) AS players\nFROM meridian.events\nWHERE game_id = $game AND event != 'position' AND $__timeFilter(ts)\nGROUP BY event\nORDER BY count DESC\nLIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "count"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-BlPu"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "event"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open in Events",
                    "url": "/d/meridian-events/events?var-game=${game}&var-event=${__value.raw}&${__url_time_range}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "All events except position samples, including custom events from Meridian.Track. Click an event to explore it."
    },
    {
      "id": 13,
      "type": "geomap",
      "title": "Position heatmap",
      "gridPos": {
        "x": 8,
        "y": 20,
        "w": 16,
        "h": 14
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "WITH (SELECT greatest(max(x) - min(x), max(z) - min(z), 1) / 150 FROM meridian.events WHERE game_id = $game AND $__timeFilter(ts) AND place_id = (SELECT place_id FROM meridian.events WHERE game_id = $game AND event = 'position' AND $__timeFilter(ts) GROUP BY place_id ORDER BY count() DESC LIMIT 1) AND event = 'position') AS step\nSELECT\n    round((floor(x / step) + 0.5) * step) AS cell_x,\n    round((floor(z / step) + 0.5) * step) AS cell_z,\n    -cell_z * 0.0001 AS lat,\n    cell_x * 0.0001 AS lon,\n    count() AS samples,\n    log1p(samples) AS weight\nFROM meridian.events\nWHERE game_id = $game AND $__timeFilter(ts) AND place_id = (SELECT place_id FROM meridian.events WHERE game_id = $game AND event = 'position' AND $__timeFilter(ts) GROUP BY place_id ORDER BY count() DESC LIMIT 1) AND event = 'position'\nGROUP BY cell_x, cell_z"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "view": {
          "id": "fit",
          "allLayers": true,
          "lastOnly": false,
          "padding": 20,
          "lat": 0,
          "lon": 0,
          "zoom": 20
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": false,
          "showScale": false,
          "showMeasure": false,
          "showDebug": false
        },
        "basemap": {
          "type": "carto",
          "name": "Basemap",
          "opacity": 0,
          "config": {
            "theme": "dark",
            "showLabels": false
          }
        },
        "layers": [
          {
            "type": "markers",
            "name": "Extent",
            "opacity": 0,
            "tooltip": false,
            "config": {
              "showLegend": false,
              "style": {
                "size": {
                  "fixed": 1
                },
                "color": {
                  "fixed": "transparent"
                }
              }
            },
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "filterData": {
              "id": "byRefId",
              "options": "A"
            }
          },
          {
            "type": "heatmap",
            "name": "Traffic",
            "tooltip": false,
            "config": {
              "blur": 12,
              "radius": 6,
              "weight": {
                "field": "weight",
                "fixed": 1,
                "min": 0.2,
                "max": 0.75
              }
            },
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "filterData": {
              "id": "byRefId",
              "options": "A"
            }
          }
        ],
        "tooltip": {
          "mode": "details"
        }
      },
      "description": "Where players spend time in the most played place, seen from above (X right, Z down). Scroll to zoom. The Map dashboard adds deaths and other places.",
      "pluginVersion": "13.2.3"
    },
    {
      "id": 14,
      "type": "table",
      "title": "Live servers",
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT\n    if(server_id = '', '(Studio)', server_id) AS server,\n    toString(any(place_id)) AS place,\n    uniqExactIf(session_id, session_id != '') AS players,\n    count() AS events,\n    max(ts) AS last_event\nFROM meridian.events\nWHERE game_id = $game AND ts > now() - INTERVAL 30 SECOND\nGROUP BY server_id\nORDER BY players DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Servers that sent an event in the last 30 seconds."
    }
  ]
}
