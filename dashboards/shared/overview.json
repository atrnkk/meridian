          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT $__timeInterval(ts) AS time, count() AS deaths\nFROM meridian.events\nWHERE game_id = $game AND event = 'death' AND $__timeFilter(ts)\nGROUP BY time\nORDER BY time"
