      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT uniqExact(session_id) AS players\nFROM meridian.events\nWHERE game_id = $game AND session_id != '' AND ts > now() - INTERVAL 30 SECOND"
        }
      ],
      "fieldConfig": {
        "defaults": {
