{
  "uid": "meridian-overview",
  "title": "Overview",
  "description": "Built-in Meridian events for one game. Pick the game at the top.",
  "tags": [
    "meridian"
  ],
  "schemaVersion": 41,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "links": [
    {
      "title": "Meridian",
      "type": "dashboards",
      "tags": [
        "meridian"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": false,
      "icon": "external link"
