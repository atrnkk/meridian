          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Distinct players with any event in each interval.",
      "interval": "10s"
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Joins and leaves",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT $__timeInterval(ts) AS time, countIf(event = 'join') AS joins, countIf(event = 'leave') AS leaves\nFROM meridian.events\nWHERE game_id = $game AND event IN ('join', 'leave') AND $__timeFilter(ts)\nGROUP BY time\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1m"
    },
    {
      "id": 9,
      "type": "barchart",
      "title": "Session length",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT\n    multiIf(d < 60, '< 1m', d < 300, '1-5m', d < 900, '5-15m', d < 1800, '15-30m', d < 3600, '30-60m', '60m+') AS length,\n    count() AS sessions\nFROM (\n    SELECT JSONExtractFloat(props, 'duration') AS d\n    FROM meridian.events\n    WHERE game_id = $game AND event = 'leave' AND $__timeFilter(ts)\n)\nGROUP BY length\nORDER BY min(d)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "xField": "length",
        "orientation": "vertical",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi"
        },
        "showValue": "auto",
        "xTickLabelSpacing": 0
      },
      "description": "Sessions that ended in the selected time range, by length."
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Deaths",
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 8
