        }
      },
      "description": "Where players die on the X/Z plane.",
      "pluginVersion": "13.2.3"
    },
    {
      "id": 7,
      "type": "table",
      "title": "Deadliest spots",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 11
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT cell_x, cell_z, deaths, samples, round(1000 * deaths / samples, 1) AS per_1000_samples\nFROM (\n    SELECT\n        (floor(x / $cell) + 0.5) * $cell AS cell_x,\n        (floor(z / $cell) + 0.5) * $cell AS cell_z,\n        countIf(event = 'death') AS deaths,\n        countIf(event = 'position') AS samples\n    FROM meridian.events\n    WHERE game_id = $game AND place_id = $place AND $__timeFilter(ts) AND event IN ('death', 'position')\n    GROUP BY cell_x, cell_z\n)\nWHERE deaths > 0 AND samples >= 20\nORDER BY per_1000_samples DESC\nLIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "per_1000_samples"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
