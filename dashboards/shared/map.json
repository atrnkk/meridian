            },
            "y": {
              "matcher": {
                "id": "byName",
                "options": "cell_z"
              }
            },
            "color": {
              "matcher": {
                "id": "byName",
                "options": "deaths"
              }
            }
          }
        ],
        "legend": {
          "showLegend": false
        },
        "tooltip": {
