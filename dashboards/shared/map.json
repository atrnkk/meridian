      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "description": "Distinct players seen in this place."
    },
    {
      "id": 5,
      "type": "geomap",
      "title": "Traffic and deaths",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 18
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "WITH (SELECT greatest(max(x) - min(x), max(z) - min(z), 1) / 150 FROM meridian.events WHERE game_id = $game AND place_id = $place AND $__timeFilter(ts) AND event = 'position') AS step\nSELECT\n    round((floor(x / step) + 0.5) * step) AS cell_x,\n    round((floor(z / step) + 0.5) * step) AS cell_z,\n    -cell_z * 0.0001 AS lat,\n    cell_x * 0.0001 AS lon,\n    count() AS samples,\n    log1p(samples) AS weight\nFROM meridian.events\nWHERE game_id = $game AND place_id = $place AND $__timeFilter(ts) AND event = 'position'\nGROUP BY cell_x, cell_z"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "WITH (SELECT greatest(max(x) - min(x), max(z) - min(z), 1) / 150 FROM meridian.events WHERE game_id = $game AND place_id = $place AND $__timeFilter(ts) AND event = 'position') AS step\nSELECT\n    round((floor(x / step) + 0.5) * step) AS cell_x,\n    round((floor(z / step) + 0.5) * step) AS cell_z,\n    -cell_z * 0.0001 AS lat,\n    cell_x * 0.0001 AS lon,\n    count() AS deaths,\n    log1p(deaths) AS weight\nFROM meridian.events\nWHERE game_id = $game AND place_id = $place AND $__timeFilter(ts) AND event = 'death'\nGROUP BY cell_x, cell_z"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
