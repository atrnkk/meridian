  "timepicker": {},
  "links": [
    {
      "title": "Meridian",
      "type": "dashboards",
      "tags": [
        "meridian"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": false,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "game",
        "label": "Game",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "clickhouse"
        },
        "refresh": 1,
        "sort": 1,
        "query": "WITH seen AS (SELECT game_id FROM meridian.events WHERE ts > now() - INTERVAL 30 DAY GROUP BY game_id)\nSELECT game_id, if(g.name = '', toString(game_id), g.name) AS label\nFROM seen LEFT JOIN (SELECT game_id, name FROM meridian.games FINAL) AS g USING (game_id)\nUNION ALL\nSELECT 0, 'No data yet' WHERE (SELECT count() FROM seen) = 0",
        "definition": "WITH seen AS (SELECT game_id FROM meridian.events WHERE ts > now() - INTERVAL 30 DAY GROUP BY game_id)\nSELECT game_id, if(g.name = '', toString(game_id), g.name) AS label\nFROM seen LEFT JOIN (SELECT game_id, name FROM meridian.games FINAL) AS g USING (game_id)\nUNION ALL\nSELECT 0, 'No data yet' WHERE (SELECT count() FROM seen) = 0"
      },
      {
        "name": "place",
        "label": "Place",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "clickhouse"
        },
        "refresh": 2,
        "query": "WITH places AS (\n    SELECT place_id, count() AS samples FROM meridian.events\n    WHERE game_id = $game AND event = 'position' AND ts > now() - INTERVAL 30 DAY\n    GROUP BY place_id\n)\nSELECT place_id, label FROM (\n    SELECT place_id, toString(place_id) AS label, samples FROM places\n    UNION ALL\n    SELECT 0, 'No positions yet', 0 WHERE (SELECT count() FROM places) = 0\n)\nORDER BY samples DESC",
        "definition": "WITH places AS (\n    SELECT place_id, count() AS samples FROM meridian.events\n    WHERE game_id = $game AND event = 'position' AND ts > now() - INTERVAL 30 DAY\n    GROUP BY place_id\n)\nSELECT place_id, label FROM (\n    SELECT place_id, toString(place_id) AS label, samples FROM places\n    UNION ALL\n    SELECT 0, 'No positions yet', 0 WHERE (SELECT count() FROM places) = 0\n)\nORDER BY samples DESC",
        "sort": 0
      },
      {
        "name": "cell",
        "label": "Spot size (studs)",
        "type": "custom",
        "query": "4,8,16,32,64,128",
        "current": {
          "text": "16",
          "value": "16"
        },
        "options": [
          {
            "text": "4",
            "value": "4",
            "selected": false
          },
          {
            "text": "8",
            "value": "8",
            "selected": false
          },
          {
            "text": "16",
            "value": "16",
            "selected": true
          },
          {
            "text": "32",
            "value": "32",
            "selected": false
          },
          {
            "text": "64",
            "value": "64",
            "selected": false
          },
          {
            "text": "128",
            "value": "128",
            "selected": false
          }
        ]
      }
    ]
