          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT\n    (floor(x / $cell) + 0.5) * $cell AS cell_x,\n    (floor(z / $cell) + 0.5) * $cell AS cell_z,\n    count() AS deaths\nFROM meridian.events\nWHERE game_id = $game AND place_id = $place AND $__timeFilter(ts) AND event = 'death'\nGROUP BY cell_x, cell_z\nORDER BY deaths\nLIMIT 20000"
        }
      ],
      "fieldConfig": {
        "defaults": {
