                "id": "custom.width",
                "value": 75
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "deaths"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 75
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "samples"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 75
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Cells where deaths are most likely relative to the time players spend there. Cells with fewer than 20 samples are left out."
    },
    {
      "id": 8,
      "type": "barchart",
      "title": "Height profile",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 11
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "WITH\n    (SELECT min(y) FROM meridian.events WHERE game_id = $game AND place_id = $place AND $__timeFilter(ts) AND event = 'position') AS lo,\n    (SELECT greatest(max(y) - min(y), 1) / 20 FROM meridian.events WHERE game_id = $game AND place_id = $place AND $__timeFilter(ts) AND event = 'position') AS step\nSELECT\n    toString(round(lo + band * step)) AS height,\n    round(100 * samples / nullIf(sum(samples) OVER (), 0), 1) AS time_spent,\n    round(100 * deaths / nullIf(sum(deaths) OVER (), 0), 1) AS deaths\nFROM (\n    SELECT greatest(least(floor((y - lo) / step), 19), 0) AS band,\n        countIf(event = 'position') AS samples, countIf(event = 'death') AS deaths\n    FROM meridian.events\n    WHERE game_id = $game AND place_id = $place AND $__timeFilter(ts) AND event IN ('death', 'position')\n    GROUP BY band\n)\nORDER BY band DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "deaths"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "time_spent"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "height",
        "orientation": "horizontal",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "showValue": "auto",
        "xTickLabelSpacing": 100
      },
      "description": "Share of time spent and share of deaths in 20 height (Y) bands, highest at the top. Where the red bar is longer, players die more than their time there would suggest."
    }
