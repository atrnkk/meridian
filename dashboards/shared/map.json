            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT uniqExact(user_id) AS players FROM meridian.events WHERE game_id = $game AND place_id = $place AND $__timeFilter(ts) AND event = 'position'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
