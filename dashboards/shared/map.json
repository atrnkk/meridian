        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Deaths per player-hour",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT countIf(event = 'death') / nullIf(countIf(event = 'position') * 5 / 3600, 0) AS rate\nFROM meridian.events\nWHERE game_id = $game AND place_id = $place AND $__timeFilter(ts) AND event IN ('death', 'position')"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "–",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "description": "Deaths divided by time spent in this place, estimated from position samples."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Cells visited",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT uniqExact(floor(x / $cell), floor(z / $cell)) AS cells FROM meridian.events WHERE game_id = $game AND place_id = $place AND $__timeFilter(ts) AND event = 'position'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "–"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "description": "Distinct map cells with at least one position sample, at the selected cell size."
    },
    {
      "id": 5,
      "type": "xychart",
      "title": "Player traffic",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 16
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT\n    (floor(x / $cell) + 0.5) * $cell AS cell_x,\n    (floor(z / $cell) + 0.5) * $cell AS cell_z,\n    count() AS samples\nFROM meridian.events\nWHERE game_id = $game AND place_id = $place AND $__timeFilter(ts) AND event = 'position'\nGROUP BY cell_x, cell_z\nORDER BY samples\nLIMIT 20000"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-BlYlRd"
          },
          "custom": {
            "show": "points",
            "pointShape": "square",
            "pointSize": {
              "fixed": 8
            },
            "pointStrokeWidth": 0,
            "fillOpacity": 90
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cell_x"
            },
            "properties": [
              {
                "id": "custom.axisLabel",
                "value": "X (studs)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cell_z"
            },
            "properties": [
              {
                "id": "custom.axisLabel",
                "value": "Z (studs)"
              }
            ]
          }
        ]
      },
      "options": {
        "mapping": "manual",
        "series": [
          {
            "frame": {
              "matcher": {
                "id": "byIndex",
                "options": 0
              }
            },
            "x": {
              "matcher": {
                "id": "byName",
                "options": "cell_x"
              }
            },
            "y": {
              "matcher": {
                "id": "byName",
                "options": "cell_z"
              }
            },
            "color": {
              "matcher": {
                "id": "byName",
                "options": "samples"
              }
            }
          }
        ],
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "description": "Where players spend time, from position samples on the X/Z plane.",
      "pluginVersion": "13.2.3"
    },
